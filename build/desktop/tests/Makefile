	cd "/Users/johan/  GGZ/build/desktop" && $(MAKE) $(MAKESILENT) -f tests/CMakeFiles/smoke_test.dir/build.make tests/CMakeFiles/smoke_test.dir/smoke_test.cpp.s
.PHONY : smoke_test.cpp.s

